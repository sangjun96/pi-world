{
	"name": "pi-world",
	"type": "module",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun --filter '*' --parallel dev",
		"dev:server": "bun --filter server dev",
		"dev:web": "bun --filter web dev",
		"build": "bun --filter web build && bun --filter server build",
		"build:server": "bun --filter server build",
		"build:web": "bun --filter web build",
		"start": "bun --filter server start",
		"start:server": "bun --filter server start",
		"start:web": "bun --filter web start",
		"typecheck": "tsc --noEmit",
		"check": "bunx biome check",
		"check:fix": "bunx biome check --fix"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^7"
	}
}
